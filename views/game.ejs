<%#
  Level 1 is rendered here on the server, so the page reads correctly before
  any script runs. public/js/game.js then swaps the text for the other levels
  without loading a new page.
-%>
<%- include('partials/head') %>

<main class="layout">

  <section class="panel" id="finish" hidden>
    <h2>Every level cleared</h2>
    <p id="finish-text"></p>
    <button type="button" id="finish-replay">Start again from level 1</button>
  </section>

  <div class="column">
    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title">Progress</h2>
        <button type="button" class="ghost" id="reset">Reset</button>
      </div>
      <ol class="reel" id="level-map">
        <% levels.forEach(function (level) { %>
        <li>
          <button type="button" class="frame<%= level.id === 1 ? ' is-current' : '' %>" data-level="<%= level.id %>"
                  title="<%= level.title %>" <%= level.id === 1 ? '' : 'disabled' %>><%= level.id %></button>
        </li>
        <% }) %>
      </ol>
    </section>

    <section class="panel panel--slate">
      <p class="level__count" id="level-count">Level 1 of <%= levels.length %></p>
      <h1 class="level__title" id="level-title"><%= levels[0].title %></h1>
      <p class="level__concept" id="level-concept"><%= levels[0].concept %></p>

      <div class="task">
        <h2>Your task</h2>
        <p id="level-task"><%= levels[0].task %></p>
      </div>

      <p class="level__attempts" id="attempts">No attempts yet</p>
    </section>
  </div>

  <div class="column">
    <section class="panel">
      <h2 class="panel__title">Build the request</h2>

      <form id="builder">
        <div class="row">
          <div class="field">
            <label for="method">Method</label>
            <select id="method">
              <option>GET</option>
              <option>POST</option>
              <option>PUT</option>
              <option>PATCH</option>
              <option>DELETE</option>
            </select>
          </div>

          <div class="field">
            <label for="path">Path</label>
            <div class="path">
              <span aria-hidden="true">/api/</span>
              <input id="path" type="text" placeholder="movies/3" autocomplete="off" spellcheck="false">
            </div>
          </div>
        </div>

        <fieldset class="field">
          <legend>Query parameters</legend>
          <div id="query-rows"></div>
          <button type="button" class="ghost" id="add-param">Add parameter</button>
        </fieldset>

        <div class="field">
          <label for="body">Body</label>
          <textarea id="body" rows="6" placeholder='{ "rating": 9.5 }' autocomplete="off" spellcheck="false" disabled></textarea>
          <p class="note" id="body-note">GET and DELETE requests carry no body.</p>
        </div>

        <p class="request-line" id="request-line">GET /api/</p>
        <button type="submit" id="send">Send request</button>
      </form>
    </section>

    <section class="panel" aria-live="polite">
      <h2 class="panel__title">Response</h2>

      <div id="verdict" hidden>
        <p class="verdict__head" id="verdict-head"></p>
        <p id="verdict-text"></p>
        <button type="button" id="next-level" hidden></button>
      </div>

      <p class="note" id="nothing-sent">Nothing sent yet.</p>

      <div id="response" hidden>
        <p class="status-line">
          Status <code class="status" id="status"></code>
          <span class="note" id="duration"></span>
        </p>
        <h3>Headers</h3>
        <dl class="headers" id="headers"></dl>
        <h3>Body</h3>
        <pre id="response-body"><code></code></pre>
      </div>
    </section>
  </div>
</main>

<%# The level text as data, for the script to read. -%>
<script type="application/json" id="level-data"><%- JSON.stringify(levels).replace(/</g, '\\u003c') %></script>

<%- include('partials/footer') %>
