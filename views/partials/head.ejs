<%# Opens <html> and <body>. partials/footer.ejs closes them. -%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page === 'game' ? 'HTTP Quest' : 'Schemas - HTTP Quest' %></title>
  <link rel="icon" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <% if (page === 'game') { %>
  <script type="module" src="/js/game.js"></script>
  <% } %>
</head>
<body>

<header class="stage">
  <div class="marquee">
    <span class="marquee__title">HTTP Quest</span>
    <span class="marquee__line">A film archive with an HTTP API</span>
  </div>

  <nav class="site-nav">
    <a href="/"<%- page === 'game' ? ' aria-current="page"' : '' %>>Game</a>
    <a href="/schemas"<%- page === 'schemas' ? ' aria-current="page"' : '' %>>Schemas</a>
  </nav>
</header>

<div class="filmstrip" aria-hidden="true"></div>
