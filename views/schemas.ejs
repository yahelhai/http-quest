<%# Rendered from src/schemas.js, the same file the API validates against. -%>
<%- include('partials/head') %>

<%
  function allowed(field) {
    if (field.values) return field.values.join(' | ');
    if (field.ref) return 'an id from ' + field.ref;
    if (field.min !== undefined && field.max !== undefined) return field.min + ' to ' + field.max;
    if (field.min !== undefined) return field.min + ' or more';
    return '';
  }
%>

<main class="layout layout--single">
  <section class="panel">
    <h1>Schemas</h1>
    <p>
      The fields and query parameters of both resources, as the server checks them.
      Worth keeping open in another tab while you play.
    </p>
    <p><a href="/">Back to the game</a></p>
  </section>

  <% resources.forEach(function (resource) { %>
  <section class="panel">
    <h2 class="resource"><%= resource.name %> <code><%= resource.path %></code></h2>

    <h3>Fields</h3>
    <table>
      <thead>
        <tr><th>Field</th><th>Type</th><th>Required</th><th>Values</th></tr>
      </thead>
      <tbody>
        <% resource.fields.forEach(function (field) { %>
        <tr>
          <td><code><%= field.name %></code></td>
          <td><%= field.type %></td>
          <td><%= field.readonly ? 'set by the server' : (field.required ? 'yes' : 'no') %></td>
          <td><%= allowed(field) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <h3>Query parameters</h3>
    <table>
      <thead>
        <tr><th>Parameter</th><th>Type</th><th>Values</th><th>Effect</th></tr>
      </thead>
      <tbody>
        <% resource.queries.forEach(function (parameter) { %>
        <tr>
          <td><code><%= parameter.name %></code></td>
          <td><%= parameter.type %></td>
          <td><%= allowed(parameter) %></td>
          <td><%= parameter.about %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% }) %>

  <section class="panel">
    <h2>Endpoints</h2>
    <table>
      <thead>
        <tr><th>Method</th><th>Path</th><th>Answers</th></tr>
      </thead>
      <tbody>
        <% endpoints.forEach(function (endpoint) { %>
        <tr>
          <td><%= endpoint.method %></td>
          <td><code><%= endpoint.path %></code></td>
          <td class="statuses">
            <% endpoint.status.forEach(function (code) { %><span class="status status--<%= Math.floor(code / 100) %>xx"><%= code %></span><% }) %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>

<%- include('partials/footer') %>
